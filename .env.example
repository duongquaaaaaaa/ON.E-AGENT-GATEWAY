# ON.E Agent Gateway — Environment Variables
# Copy to .env and fill in values

# Module 1: Gemini API key (optional — pipeline can run offline using cache)
GEMINI_API_KEY=your_gemini_api_key_here

# Module 1: Override output path (optional)
# MODULE1_OUTPUT_PATH=./module1/output/catalog_standardized.json

# Module 2: API keys for dashboard (optional, defaults to demo/hackathon2026)
# MODULE2_API_KEY=demo

# Module 3: Server port (optional, defaults to 8000)
# MODULE3_PORT=8000
